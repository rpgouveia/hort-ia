  {
    "id": "tomate_begomovirose",
    "cv_dataset": "new_plant_diseases_dataset",
    "cv_label": "Tomato___Tomato_Yellow_Leaf_Curl_Virus",
    "type": "disease",
    "name_pt": "Begomovirose (TYLCV)",
    "causal_agent": "Tomato yellow leaf curl virus",
    "crop_ids": [
      "tomate"
    ],
    "beneficial": null,
    "symptoms": "Folhas e brotos novos amarelados, com manchas de verde claro e escuro (mosaico) e enrugados.",
    "management": [
      {
        "type": "cultural",
        "description": "Não há cura depois que aparece: arranque logo as plantas doentes e destrua-as longe da horta.",
        "source": {
          "source_id": "embrapa_ct47_cultivo_hortalicas",
          "pages": "11"
        }
      },
      {
        "type": "preventive",
        "description": "Combata os insetos que transmitem o vírus, como mosca-branca, pulgões e tripes.",
        "source": {
          "source_id": "embrapa_ct47_cultivo_hortalicas",
          "pages": "11"
        }
      },
      {
        "type": "preventive",
        "description": "Use sementes sadias e limpe as ferramentas: o vírus também passa por ferimentos e pelo contato com plantas doentes.",
        "source": {
          "source_id": "embrapa_ct47_cultivo_hortalicas",
          "pages": "11"
        }
      },
      {
        "type": "cultural",
        "description": "Elimine plantações velhas e doentes antes de começar um novo plantio.",
        "source": {
          "source_id": "embrapa_ct47_cultivo_hortalicas",
          "pages": "11"
        }
      }
    ],
    "sources": [
